}// ===== START WEBSITE =====
function startWebsite() {
    document.getElementById("intro").classList.add("hidden");
    document.getElementById("passwordScreen").classList.remove("hidden");
}

// ===== PASSWORD =====
function checkPassword() {
    const password = document.getElementById("password").value;

    if (password === "110426") {
        document.getElementById("passwordScreen").classList.add("hidden");
        document.getElementById("website").classList.remove("hidden");
    } else {
        document.getElementById("wrongPassword").innerHTML = "❌ Wrong Password";
    }
}

// ===== BIRTHDAY COUNTDOWN =====
// Change the year if needed
const birthday = new Date("August 15, 2026 00:00:00").getTime();

setInterval(function () {

    const now = new Date().getTime();

    const distance = birthday - now;

    if (distance <= 0) {
        document.getElementById("timer").innerHTML =
            "🎉 Happy Birthday Muzammil ❤️";
        return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) /
        (1000 * 60 * 60));

    const minutes = Math.floor((distance % (1000 * 60 * 60)) /
        (1000 * 60));

    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("timer").innerHTML =
        days + "d " +
        hours + "h " +
        minutes + "m " +
        seconds + "s";

}, 1000);

// ===== 100 REASONS =====

const reasons = [

"Because you make me smile.",
"Because you're my best friend.",
"Because you always support me.",
"Because you're handsome.",
"Because you're kind.",
"Because you make me feel safe.",
"Because your hugs are home.",
"Because your smile is beautiful.",
"Because you believe in us.",
"Because you make me laugh."

];

// Auto-fill remaining reasons
for(let i = reasons.length + 1; i <= 100; i++){
    reasons.push("Reason #" + i + " — Because I love everything about you ❤️");
}

const container = document.getElementById("reasonContainer");

reasons.forEach(reason => {

    const card = document.createElement("div");

    card.className = "reason";

    card.innerHTML = reason;

    container.appendChild(card);

});

// ===== CONFETTI =====

function celebrate(){

confetti({

particleCount:300,

spread:200,

origin:{y:0.6}

});

}

// ===== OPEN WHEN LETTERS =====

